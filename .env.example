# Copy this file to .env. Keep deployment values and credentials out of Git.
# Existing configurations without the two mode settings retain genie-agent
# and managed-oauth behavior.

FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<foundry-project>
DATABRICKS_WORKSPACE_HOST=https://<databricks-workspace>.azuredatabricks.net
DATABRICKS_INTEGRATION_MODE=genie-agent
DATABRICKS_GENIE_SPACE_ID=<genie-space-id>
FOUNDRY_CONNECTION_MODE=managed-oauth
FOUNDRY_CONNECTION_NAME=databricks-genie
FOUNDRY_TOOLBOX_NAME=databricks-genie-toolbox

# For Genie One:
# 1. Set DATABRICKS_INTEGRATION_MODE=genie-one.
# 2. Remove DATABRICKS_GENIE_SPACE_ID (including from your shell environment).
# 3. Uncomment and set DATABRICKS_WORKSPACE_ID below.
# 4. Set FOUNDRY_CONNECTION_MODE=existing-oauth.
# 5. Use new connection/Toolbox names. Create the OAuth connection in Foundry
#    first, with ai-gateway and offline_access. See docs/custom-oauth.md.
# DATABRICKS_WORKSPACE_ID=<workspace-id>

# Optional dedicated test-agent bootstrap (requires the [bootstrap] package extra).
# These settings are ignored by normal setup; no agent is created without --apply.
# FOUNDRY_TEST_AGENT_NAME=databricks-genie-test
# FOUNDRY_MODEL_DEPLOYMENT=<existing-model-deployment-name>
# Default: <test-agent-name>-toolbox; must differ from FOUNDRY_CONNECTION_NAME.
# FOUNDRY_TOOLBOX_CONNECTION_NAME=databricks-genie-test-toolbox

# Existing-agent testing also uses FOUNDRY_TEST_AGENT_NAME, but reads the model,
# pinned Toolbox version and optional binding from the saved agent itself.
# test-agent does not require FOUNDRY_MODEL_DEPLOYMENT or
# FOUNDRY_TOOLBOX_CONNECTION_NAME and never provisions resources.
